<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="project.ProjectTaskCalendarListToPlan">
        <h5>Tasks to Schedule</h5>
        <span class="text-muted">Drag &amp; drop tasks to schedule them</span>
        <div class="list-group">
            <div class="list-group-item cursor-pointer text-wrap o_task_to_plan_draggable" t-foreach="props.model.tasksToPlan.records" t-as="task" t-key="task.id" t-att-data-res-id="task.id" t-on-click="() => this.openRecord(task)">
                <span t-out="task.name"/>
            </div>
        </div>
        <button t-if="displayLoadMoreButton" class="btn btn-link" t-on-click="loadMoreTasksToPlan">Load More</button>
    </t>
</templates>
