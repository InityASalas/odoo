<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="website.FooterTemplateOption" t-inherit-mode="extension">
        <xpath expr="//BuilderSelectItem[last()]" position="after">
                <BuilderSelectItem title.translate="eCommerce"
                    actionParam="{ view: 'website_sale.template_footer_website_sale', vars: { 'footer-template': 'website_sale' } }"
                >
                    <Img src="'/website/static/src/img/snippets_options/footer_template_headline.svg'"/>
                </BuilderSelectItem>
        </xpath>
    </t>

</templates>
